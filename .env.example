# ── Adatbázis (közös Supabase projekt, `mdschool` séma) ───────────────
# Supabase → Connect → Transaction pooler (6543-as port). Nélküle az oldal a
# lib/defaults.ts tartalmát mutatja, a jelentkezés és az admin nem működik.
DATABASE_URL=

# ── Supabase (admin belépés e-mailes kóddal + képfeltöltés) ───────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# CSAK szerveroldalon! Soha ne kapjon NEXT_PUBLIC_ előtagot.
SUPABASE_SERVICE_ROLE_KEY=

# Admin aldomain (pl. admin.mddanceschool.hu). Üresen az admin a /admin címen van.
ADMIN_HOST=

# ── E-mail (Resend) — ugyanaz a fiók, mint a stúdióbérlés oldalon ────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# „Írj nekünk” űrlap címzettje
BOOKING_NOTIFICATION_EMAIL=
# Új jelentkezés (óra / tábor) értesítés — több cím vesszővel
APPLICATION_NOTIFY_EMAIL=
# "true" = a jelentkező is kap visszaigazoló e-mailt
APPLICANT_CONFIRMATION_ENABLED=false

# Az oldal címe (e-mailekben lévő admin linkekhez)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Véletlen szöveg az IP-címek hasheléséhez (spamvédelem)
IP_HASH_SALT=

# A stúdióbérlés app (md-studio-rental) címe — a /studio-berles alatti kéréseket ide továbbítjuk
# (a látogató a hiphoptanciskola.com/studio-berles címen marad). Build időben olvassuk: változás után redeploy.
STUDIO_RENTAL_ORIGIN=http://localhost:3001
